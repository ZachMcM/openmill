{
  "name": "openmill",
  "version": "0.4.1",
  "description": "A local software factory that turns design docs into pull requests.",
  "keywords": [
    "agents",
    "automation",
    "claude",
    "design-docs",
    "pull-requests"
  ],
  "homepage": "https://github.com/ZachMcM/openmill#readme",
  "bugs": "https://github.com/ZachMcM/openmill/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZachMcM/openmill.git",
    "directory": "apps/cli"
  },
  "bin": {
    "openmill": "./dist/bin/openmill.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@hono/node-server": "^2.1.8",
    "commander": "^15.1.0",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.18",
    "ora": "^10.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openmill/assets": "workspace:*",
    "@openmill/core": "workspace:*",
    "@openmill/server": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
